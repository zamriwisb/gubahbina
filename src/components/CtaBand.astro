---
import Icon from './Icon.astro';
import { site, waLink } from '../config/site';

interface Props {
  heading?: string;
  body?: string;
  /** Message pre-filled into the visitor's WhatsApp chat. */
  message?: string;
}

const {
  heading = 'Ada masalah hakisan atau tebing di tapak anda?',
  body = 'Hantar gambar keadaan tapak melalui WhatsApp. Kami akan lihat keadaannya dan cadangkan penyelesaian gabion wall yang sesuai, serta aturkan semakan tapak jika perlu.',
  message = 'Salam, saya ada masalah di tapak saya dan ingin dapatkan cadangan serta sebut harga gabion wall.',
} = Astro.props;
---

<section class="cta field-brand">
  <div class="wrap cta__inner">
    <div class="cta__text">
      <h2>{heading}</h2>
      <p class="lede">{body}</p>
    </div>
    <div class="cta__actions">
      <a class="btn" href={waLink(message)} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={20} />
        WhatsApp Sekarang
      </a>
      <a class="btn btn--onDark" href={`tel:${site.contact.phoneNumber}`}>
        <Icon name="phone" size={20} />
        {site.contact.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--space-3xl);
  }

  .cta__inner {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .cta__inner {
      grid-template-columns: 1.5fr 1fr;
      gap: var(--space-2xl);
    }
  }

  .cta__text h2 {
    max-width: 20ch;
  }

  .cta__text .lede {
    margin-top: var(--space-s);
    max-width: 54ch;
  }

  .cta__actions {
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }

  @media (min-width: 30rem) and (max-width: 59.999rem) {
    .cta__actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
