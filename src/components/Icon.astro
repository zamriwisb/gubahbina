---
/**
 * Authored icon set. One 24×24 grid, 1.75 stroke, round caps and joins.
 * Brand marks (WhatsApp, Facebook) are the only filled glyphs.
 * No emoji or unicode characters are used as icons anywhere on this site.
 */

import type { IconName } from '../types';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;

/** Filled brand marks — drawn as solid glyphs, not strokes. */
