/** Stroked pictograms — each path list is drawn with a shared stroke style. */
const STROKED: Partial<Record<IconName, string[]>> = {
  // Ground giving way: a bank profile with the face slipping downward.
  'slope-fail': ['M2 20h20', 'M3 20V9c0-1.1.9-2 2-2h4l2 3', 'M11 10l3 4 3-1 4 7', 'M12 4v3.5', 'M15.5 5l-1.2 3.3', 'M8.5 5l1.2 3.3'],
  // A wire cage: the mesh grid that defines the product.
  gabion: ['M3 6h18v12H3z', 'M9 6v12', 'M15 6v12', 'M3 10h18', 'M3 14h18'],
  // Water passing straight through the structure rather than building behind it.
  drainage: ['M8 3v18', 'M16 3v18', 'M2 8h17', 'M16.5 5.5 19.5 8l-3 2.5', 'M2 16h17', 'M16.5 13.5 19.5 16l-3 2.5'],
  // Stone courses laid in a retaining wall, staggered.
  wall: ['M3 5h18v14H3z', 'M3 9.66h18', 'M3 14.33h18', 'M10 5v4.66', 'M17 5v4.66', 'M6.5 9.66v4.67', 'M13.5 9.66v4.67', 'M20.5 9.66v4.67', 'M10 14.33V19', 'M17 14.33V19'],
