  warning: ['M12 4 2.8 20h18.4z', 'M12 10v4.5', 'M12 17.4v.1'],
  check: ['M4 12.5 9 17.5 20 6.5'],
  'arrow-right': ['M4 12h15', 'M13 6l6 6-6 6'],
  'chevron-down': ['M6 9.5l6 6 6-6'],
